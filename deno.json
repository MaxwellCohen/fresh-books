{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "deno run -A --env-file=.env npm:vite",
    "build": "vite build && deno run -A scripts/adapt.mjs",
    "deploy:vercel": "VERCEL=1 deno task build && vercel deploy --prebuilt --prod --yes",
    "deploy:netlify": "NETLIFY=1 deno task build && npx --yes netlify-cli deploy --prod --no-build --dir _fresh/client",
    "deploy:cloudflare": "CLOUDFLARE=1 deno task build && npx --yes wrangler deploy",
    "preview:cloudflare": "CLOUDFLARE=1 deno task build && npx --yes wrangler dev",
    "start": "deno serve -A --env-file=.env _fresh/server.js",
    "check": "deno lint && deno check",
    "update": "deno run -A -r jsr:@fresh/update .",
    "test:features": "cd feature-tests && npm install --no-audit --no-fund && npm run test:features"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ],
      "exclude": [
        "require-await",
        "react-no-danger",
        "no-window"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "feature-tests/"
  ],
  "imports": {
    "@/": "./",
    "@fontsource-variable/geist": "npm:@fontsource-variable/geist@^5.3.0",
    "@fontsource-variable/geist-mono": "npm:@fontsource-variable/geist-mono@^5.3.0",
    "@netlify/blobs": "npm:@netlify/blobs@^11.1.9",
    "@vercel/functions": "npm:@vercel/functions@^3.11.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "rollup-plugin-visualizer": "npm:rollup-plugin-visualizer@^6.0.11",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "drizzle-orm": "npm:drizzle-orm@^0.45.2",
    "drizzle-orm/": "npm:/drizzle-orm@^0.45.2/",
    "@neondatabase/serverless": "npm:@neondatabase/serverless@^1.1.0",
    "clsx": "npm:clsx@^2.1.1",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "thumbhash": "npm:thumbhash@^0.1.1",
    "vite-imagetools": "npm:vite-imagetools@^9.0.3"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}